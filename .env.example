# Configuración de base de datos
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# Configuración de Zona Horaria
TZ=America/Argentina/Buenos_Aires
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires

# Clave de encriptación (¡Muy importante!)
# No cambies esta clave despues de crear credenciales en n8n, o dejaran de poder desencriptarse.
N8N_ENCRYPTION_KEY=

# ==========================================================================
# ============================ LobeChat / LobeHub ==========================
# ==========================================================================
# Puerto de la interfaz web de LobeChat (unico puerto que se expone al host).
LOBE_PORT=3210

# URL con la que el navegador accede a LobeChat.
APP_URL=http://localhost:3210
# URL interna que el contenedor usa para hablar consigo mismo (features async
# como generacion de imagenes). Para docker compose se recomienda localhost.
INTERNAL_APP_URL=http://localhost:3210

# --- Secretos (generados con RNG, NO reutilizar en otro entorno) ---
# Cifra las API keys que los usuarios guardan en LobeChat. Si la pierdes,
# esos datos quedan inaccesibles (equivalente a N8N_ENCRYPTION_KEY).
KEY_VAULTS_SECRET=
# Secreto de autenticacion (Better Auth / NextAuth).
AUTH_SECRET=

# --- Postgres dedicado a LobeChat (contenedor lobe-postgres, aislado) ---
# NO comparte servidor con tu Postgres de n8n/aura.
LOBE_DB_NAME=lobechat
LOBE_POSTGRES_PASSWORD=

# --- Almacenamiento S3 (RustFS) ---
# S3_ENDPOINT debe ser accesible desde el navegador para subir imagenes al
# chat; por eso apunta a localhost:9000 (puerto publicado).
S3_ENDPOINT=http://localhost:9000
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_LOBE_BUCKET=lobe
